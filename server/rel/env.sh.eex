#!/bin/sh

# On Railway private networking, each container gets a unique IPv6 address in
# an fd.. range. We name the BEAM node "eir@<that-ipv6>" so every replica has
# a distinct, directly-routable name. dns_cluster queries the service's
# internal DNS, gets back every replica's IPv6, and connects to eir@<ip>
# for each — giving us a full mesh across the replicas.

export ERL_AFLAGS="-proto_dist inet6_tcp"
export RELEASE_DISTRIBUTION=name

if [ -n "$RAILWAY_PRIVATE_IP" ]; then
  MY_IP="$RAILWAY_PRIVATE_IP"
else
  MY_IP=$(hostname -i 2>/dev/null | awk '{print $1}')
fi

export RELEASE_NODE="${RELEASE_NODE:-eir@${MY_IP:-127.0.0.1}}"
